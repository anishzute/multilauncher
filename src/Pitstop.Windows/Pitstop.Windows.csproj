<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Loadout</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/loadout.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <Company>Loadout</Company>
    <Product>Loadout</Product>
    <Title>Loadout</Title>
    <Description>One click to your next setup.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- WPF owns DPI configuration. Windows Forms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Pitstop.Core/Pitstop.Core.csproj" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <Resource Include="Assets/loadout.ico" />
  </ItemGroup>
</Project>

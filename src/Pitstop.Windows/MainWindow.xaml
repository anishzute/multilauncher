<Window x:Class="Pitstop.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Pitstop.Windows"
 Title="Pitstop" Style="{StaticResource {x:Type Window}}" Width="1220" Height="860" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen" Icon="Assets/pitstop.ico" Closing="Window_Closing">
 <Window.Resources>
  <DataTemplate x:Key="AppRow">
   <Border BorderBrush="#2E2F34" BorderThickness="0,0,0,1" Padding="8,12,14,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="⠿" Foreground="#71737E" Cursor="SizeAll" VerticalAlignment="Center" ToolTip="Drag to change order"/>
     <Border Grid.Column="1" Width="32" Height="34" CornerRadius="7" Background="#303034"><Grid>
      <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D4C2B9"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=ProgramIcon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <Image x:Name="ProgramIcon" Source="{Binding Converter={StaticResource AppIcon}}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
     </Grid></Border>
     <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/><TextBlock Text="{Binding CloseHint}" Foreground="#B5A499" FontSize="9.5" Margin="0,3,0,0"/><TextBlock Text="{Binding SessionRole}" Foreground="#AED2B7" FontSize="9.5" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,4,0,0"/><Style.Triggers><DataTrigger Binding="{Binding SessionRole}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
     <Button Grid.Column="3" Content="Edit" Click="EditApp_Click" Tag="{Binding}" Style="{StaticResource Quiet}" ToolTip="Path, launch arguments, delay, and close behavior" VerticalAlignment="Center"/>
     <CheckBox Grid.Column="4" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="ToggleApp_Click" Tag="{Binding}" Margin="6,0,0,0" ToolTip="Include this app in the profile" AutomationProperties.Name="Enable app"/>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#191A1D" BorderBrush="#2B2C31" BorderThickness="0,0,1,0">
   <Grid Margin="16,24,16,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="10,0,0,31"><Border Background="{StaticResource Accent}" CornerRadius="8" Width="33" Height="33"><TextBlock Text="P" FontSize="23" FontWeight="Bold" Foreground="#211813" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/></Border><StackPanel Margin="11,0,0,0"><TextBlock Text="PITSTOP" FontSize="18" FontWeight="Bold"/><TextBlock Text="MAKE ROOM FOR WHAT’S NEXT" FontSize="7.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></StackPanel>
    <StackPanel Grid.Row="1"><Button x:Name="ProfilesNav" Content="▦    Profiles" Style="{StaticResource Nav}" Click="ProfilesNav_Click" Background="#302823"/><Button x:Name="ActivityNav" Content="◷    Session activity" Style="{StaticResource Nav}" Click="ActivityNav_Click"/><Button x:Name="SettingsNav" Content="⚙    Settings &amp; help" Style="{StaticResource Nav}" Click="SettingsNav_Click"/></StackPanel>
    <Grid Grid.Row="2" Margin="12,28,0,8"><TextBlock Text="YOUR PROFILES" FontSize="9" Foreground="{StaticResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="NewProfileButton" Content="+" HorizontalAlignment="Right" FontSize="20" Style="{StaticResource Quiet}" Padding="8,0" Click="NewProfile_Click" ToolTip="New profile"/></Grid>
    <ListBox Grid.Row="3" x:Name="ProfilesList" SelectionChanged="Profile_Changed" local:DragReorder.Enabled="True" local:DragReorder.Reordered="List_Reordered"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" Foreground="{StaticResource Accent}" FontSize="19" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="4" BorderBrush="#303136" BorderThickness="0,1,0,0" Padding="10,18,0,3"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Fill="#91C5A2" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock Text="LOCAL BY DESIGN" Foreground="#C1C1C7" FontSize="9" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Your setup stays on this PC." Foreground="#73747E" FontSize="10" Margin="13,6,0,0"/><TextBlock Text="PITSTOP  /  v0.2" Foreground="#686973" FontSize="9" Margin="13,17,0,0"/></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="30,24,30,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><StackPanel><TextBlock x:Name="PageTitle" Text="Your profiles" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="A different setup for every way you play." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Button x:Name="TopNewButton" Content="+  New profile" HorizontalAlignment="Right" VerticalAlignment="Center" Click="NewProfile_Click"/></Grid>
   <Border Grid.Row="1" x:Name="SessionBanner" CornerRadius="8" Background="#202423" BorderBrush="#35453B" BorderThickness="1" Padding="15,12" Margin="0,0,0,18" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="SessionTitle" FontWeight="SemiBold" Foreground="#B7DBBF"/><TextBlock x:Name="SessionDetail" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,8,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="EndButton" Grid.Column="1" Content="■  End &amp; restore" Click="EndSession_Click" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></Border>
   <Grid Grid.Row="2" x:Name="ProfilesPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border CornerRadius="12" BorderThickness="1" BorderBrush="#3D3531" Padding="24,22" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2D2623" Offset="0"/><GradientStop Color="#212023" Offset="1"/></LinearGradientBrush></Border.Background>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,15,0"><TextBlock x:Name="CategoryLabel" Text="RACING PROFILE" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="ProfileTitle" Text="iRacing" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5" TextWrapping="Wrap"/><TextBlock x:Name="ProfileDescription" Foreground="#B9B0AC" FontSize="12" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,19,0,0"><Button Content="Edit profile" x:Name="EditProfileButton" Style="{StaticResource Quiet}" Click="EditProfile_Click" Padding="0,3,14,3"/><Button Content="Duplicate" x:Name="DuplicateButton" Style="{StaticResource Quiet}" Click="Duplicate_Click" Padding="0,3,14,3"/><Button Content="Delete" x:Name="DeleteProfileButton" Style="{StaticResource Quiet}" Click="DeleteProfile_Click" Padding="0,3,0,3"/></StackPanel></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="StartButton" Content="▶   Start session" Style="{StaticResource Primary}" FontSize="15" Padding="23,14" Click="StartSession_Click"/><TextBlock Text="Your entire setup, one click." HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,10,0,0"/></StackPanel>
     </Grid>
    </Border>
    <Border Grid.Row="1" x:Name="SetupHint" CornerRadius="7" Background="#202126" Padding="13,11" Margin="0,16,0,16"><TextBlock Text="MAKE IT YOURS   Click Edit to choose each app on your PC, then switch it on. Starter apps are off until configured." FontSize="11" Foreground="#BDBBC2" TextWrapping="Wrap"/></Border>
    <Grid Grid.Row="2" x:Name="AppLists"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="17,17,17,13"><StackPanel><TextBlock Text="↗   Open for this session" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="OpenCount" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/></StackPanel><Button Content="+ Add" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="9,5" Click="AddOpen_Click"/></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><ItemsControl x:Name="OpenApps" local:DragReorder.Enabled="True" local:DragReorder.Reordered="List_Reordered" ItemTemplate="{StaticResource AppRow}"/><TextBlock x:Name="OpenEmpty" Text="Add your game and the tools you need." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="20" Visibility="Collapsed"/></StackPanel></ScrollViewer><TextBlock Grid.Row="2" Text="Drag rows to set launch order." Foreground="#888994" FontSize="10" Margin="17,13"/></Grid></Border>
     <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="17,17,17,13"><StackPanel><TextBlock Text="↘   Close while you play" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="CloseCount" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/></StackPanel><Button Content="+ Add" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="9,5" Click="AddClose_Click"/></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><ItemsControl x:Name="CloseApps" local:DragReorder.Enabled="True" local:DragReorder.Reordered="List_Reordered" ItemTemplate="{StaticResource AppRow}"/><TextBlock x:Name="CloseEmpty" Text="Choose background apps to make room." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="20" Visibility="Collapsed"/></StackPanel></ScrollViewer><TextBlock Grid.Row="2" Text="Reopens only apps that were running before." Foreground="#888994" FontSize="10" Margin="17,13"/></Grid></Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="Exit fully is the default. Save work before closing apps. Apps already open on the Open list stay open after the session." FontSize="10.5" Foreground="#8F909A" TextWrapping="Wrap" Margin="2,16,0,0"/>
   </Grid>
   <Grid Grid.Row="2" x:Name="ActivityPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Launches, exits, process IDs, and restore results. Pending items stay in the session record." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/><Button x:Name="ConfirmUntrackedButton" Content="I exited the unidentified apps — finish restore" HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="Collapsed" Click="ConfirmUntracked_Click"/></StackPanel><ListBox Grid.Row="1" x:Name="ActivityList"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayTime}" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource Accent}" FontSize="11"/><TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
   <ScrollViewer Grid.Row="2" x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="700" HorizontalAlignment="Left">
    <TextBlock Text="Your setup, kept local." FontSize="22" FontWeight="SemiBold" Margin="0,5,0,12"/><TextBlock Text="Profiles, process snapshots, and session history are stored on this PC. No account, telemetry, or cloud connection is required." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22"/>
    <WrapPanel Margin="0,22,0,30"><Button Content="Export profiles" Click="Export_Click" Margin="0,0,10,10"/><Button Content="Import profiles" Click="Import_Click" Margin="0,0,10,10"/><Button Content="Open data folder" Click="DataFolder_Click" Margin="0,0,10,10"/></WrapPanel>
    <TextBlock Text="How a session works" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="1. Pitstop records what is running.&#10;2. It asks the apps on your Close list to exit.&#10;3. It launches enabled apps in your Open list, in order.&#10;4. End &amp; restore closes session apps and reopens previous apps." Foreground="#BBBAC2" TextWrapping="Wrap" LineHeight="28"/>
    <TextBlock Text="A few useful details" FontSize="17" FontWeight="SemiBold" Margin="0,28,0,12"/><TextBlock Text="• Already-running apps on the Open list are kept open.&#10;• Exit completely closes tray/background processes too. Save work first.&#10;• Graceful only is available per app if you prefer to leave it running.&#10;• Restoring reopens apps; documents, layouts, and game state depend on the app.&#10;• Windows components and Windows services are excluded.&#10;• Closing Pitstop during a session sends it to the system tray.&#10;• An interrupted session can be restored the next time you open Pitstop." Foreground="#BBBAC2" TextWrapping="Wrap" LineHeight="26"/>
    <TextBlock Text="Games and Store apps" FontSize="17" FontWeight="SemiBold" Margin="0,28,0,12"/><TextBlock Text="Use an executable or a Windows shortcut. For Steam games you can also set a steam://rungameid/APPID launch target. Store apps can use shell:AppsFolder\PACKAGE!APP. Set Process executable to the actual app’s .exe; Pick running app can help find it. Launchers may require their own launch arguments." Foreground="#BBBAC2" TextWrapping="Wrap" LineHeight="23"/>
   </StackPanel></ScrollViewer>
   <Grid Grid.Row="3" Margin="0,17,0,0"><TextBlock x:Name="StatusText" Text="Ready when you are." FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="#33343A" VerticalAlignment="Bottom" Margin="0,20,0,0" Visibility="Collapsed"/></Grid>
  </Grid>
 </Grid>
</Window>
